# Dependencies & Virtual Environments (Any folder depth)
**/node_modules/
**/venv/
**/.venv/
**/env/
**/.env/

# Build & Output Directories
**/.next/
**/out/
**/build/
**/dist/

# Python Caches & Database Files
**/__pycache__/
**/*.pyc
**/*.pyo
**/*.pyd
**/.pytest_cache/
**/*.db
**/*.sqlite
**/math_platform.db

# Environment Variables & Secrets (Matches .env files at any level)
**/.env
**/.env.*
**/*.env
**/.env.local
**/.env.development.local
**/.env.test.local
**/.env.production.local

# OS & IDE Files
**/.DS_Store
**/.vscode/
**/.idea/
**/*.swp
**/*.swo

# Logs & Temporary Files
**/logs/
**/*.log
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
